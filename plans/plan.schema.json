{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/personal-training-plan/plans/plan.schema.json",
  "title": "Weekly Training Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week", "days"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "analysis_week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "summary_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "swim", "bike", "run"],
      "properties": {
        "total": { "type": "string" },
        "swim": { "type": "string" },
        "bike": { "type": "string" },
        "run": { "type": "string" }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "sessions"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sport", "title", "amount", "duration"],
              "properties": {
                "sport": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "duration": {
                  "type": "string"
                },
                "content": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
